    "content": {
      "kind": "check-rules",
      "name": "judge-wrong-law",
      "version": "judge-wrong-law-v1",
      "plain_english": "Each row is one call to the DiscoverPhysics explanation judge on a rule-written explanation in which exactly one typed field of the law is wrong (or the text is about another world, or commits to nothing). Such an explanation must not reach a pass mark.",
      "rationale": null,
      "source": "PREREGISTRATION_JUDGE.md and PREREGISTRATION_JUDGE_PANEL.md in this folder. The table is wrong_law_calls.csv beside this file, built from the three judges' call records.",
      "licence": null,
      "id_column": "call_id",
      "columns": {
        "passes_at_8": {
          "plain_english": "1 if the judge's score is 8 or more (the public code's pass mark), otherwise 0.",
          "unit": "count"
        },
        "passes_at_9": {
          "plain_english": "1 if the judge's score is 9 or more (the paper's pass mark), otherwise 0.",
          "unit": "count"
        }
      },
      "rules": [
        {
          "id": "W9",
          "kind": "bound",
          "column": "passes_at_9",
          "if_empty": "refuse",
          "plain_english": "A wrong-law explanation does not pass at the paper's mark.",
          "rationale": "The label is fixed by construction; a pass is a judge error or a rubric band that admits the error.",
          "source": null,
          "max": "0 count",
          "min_inclusive": true,
          "max_inclusive": true
        },
        {
          "id": "W8",
          "kind": "bound",
          "column": "passes_at_8",
          "if_empty": "refuse",
          "plain_english": "A wrong-law explanation does not pass at the public code's mark.",
          "rationale": "As above, at the more lenient mark.",
          "source": null,
          "max": "0 count",
          "min_inclusive": true,
          "max_inclusive": true
        }
      ]
    }
  },
